TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Firebase Admin SDK service account — Firebase Console > Project Settings >
# Service accounts > Generate new private key. Paste the three fields from
# that JSON file here (keep the quotes around FIREBASE_PRIVATE_KEY so its
# \n line breaks survive as literal characters in the .env file).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# Realtime Database URL — Firebase Console > Realtime Database (the
# "https://<project>-default-rtdb.<region>.firebasedatabase.app/" URL)
FIREBASE_DATABASE_URL=
